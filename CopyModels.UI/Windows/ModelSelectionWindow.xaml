<Window
    x:Class="CopyModels.UI.Windows.ModelSelectionWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:CopyModels.UI.Windows"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="clr-namespace:CopyModels.UI.ViewModels"
    Title="Выбор моделей"
    Width="860"
    Height="520"
    WindowStartupLocation="CenterScreen"
    d:DataContext="{d:DesignInstance Type=vm:ModelSelectionViewModel}"
    mc:Ignorable="d">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <ListBox
            x:Name="ModelList"
            Grid.Row="0"
            FontFamily="Consolas"
            ItemsSource="{Binding Items}">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="32" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <CheckBox
                            Grid.Column="0"
                            VerticalAlignment="Center"
                            IsChecked="{Binding IsSelected}" />
                        <TextBlock
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            Text="{Binding DisplayName}" />
                        <TextBlock
                            Grid.Column="2"
                            Margin="8,0,0,0"
                            VerticalAlignment="Center"
                            Foreground="Red"
                            Text="{Binding Badges}" />
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        <StackPanel
            Grid.Row="1"
            Margin="8,4,8,4"
            HorizontalAlignment="Left"
            Orientation="Horizontal">
            <Button
                Width="100"
                Margin="0,0,8,0"
                Command="{Binding CheckAllCommand}"
                Content="Check All" />
            <Button
                Width="100"
                Margin="0,0,8,0"
                Command="{Binding UncheckAllCommand}"
                Content="Uncheck All" />
            <Button
                Width="100"
                Margin="0,0,8,0"
                Command="{Binding ToggleAllCommand}"
                Content="Toggle All" />
        </StackPanel>
        <StackPanel
            Grid.Row="2"
            Margin="8,4,8,8"
            HorizontalAlignment="Right"
            Orientation="Horizontal">
            <Button
                Width="80"
                Margin="0,0,8,0"
                Command="{Binding OkCommand}"
                Content="Ok" />
            <Button
                Width="80"
                Command="{Binding CancelCommand}"
                Content="Cancel" />
        </StackPanel>
        <StatusBar Grid.Row="3">
            <StatusBarItem>
                <TextBlock Text="{Binding StatusMessage}" />
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>
