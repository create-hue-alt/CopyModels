<Window
    x:Class="CopyModels.UI.Windows.ResultsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:CopyModels.UI.Windows"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="clr-namespace:CopyModels.UI.ViewModels"
    Title="Результаты выполнения"
    Width="620"
    Height="480"
    d:DataContext="{d:DesignInstance Type=vm:ResultsViewModel}"
    WindowStartupLocation="CenterScreen"
    mc:Ignorable="d">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel
            Grid.Row="0"
            Margin="12,10,12,16"
            Orientation="Horizontal">
            <TextBlock
                Margin="0,0,6,0"
                FontFamily="Segoe MDL2 Assets"
                Foreground="Green"
                Text="&#xE73E;" />
            <TextBlock Margin="0,0,16,0" Text="{Binding SuccessCount, StringFormat='{}{0} успешно'}" />
            <TextBlock
                Margin="0,0,6,0"
                FontFamily="Segoe MDL2 Assets"
                Foreground="Red"
                Text="&#xE711;" />
            <TextBlock Text="{Binding FailureCount, StringFormat='{}{0} с ошибкой'}" />
        </StackPanel>

        <ListBox
            Grid.Row="1"
            Margin="12,0,12,8"
            FontFamily="Consolas"
            ItemsSource="{Binding Items}">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid Margin="0,4,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="24" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <TextBlock
                            Grid.Column="0"
                            VerticalAlignment="Top"
                            FontFamily="Segoe MDL2 Assets"
                            Foreground="{Binding IconBrush}"
                            Text="{Binding IconGlyph}" />

                        <StackPanel Grid.Column="1">
                            <TextBlock FontWeight="Bold" Text="{Binding ModelName}" />
                            <TextBlock Foreground="Gray" Text="{Binding Path}" />
                            <TextBlock
                                Foreground="Red"
                                Text="{Binding ErrorMessage}"
                                TextWrapping="Wrap" />
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <StackPanel
            Grid.Row="2"
            Margin="8,4,8,8"
            HorizontalAlignment="Right"
            Orientation="Horizontal">
            <Button
                Width="80"
                Command="{Binding CloseCommand}"
                Content="Закрыть" />
        </StackPanel>
    </Grid>
</Window>
