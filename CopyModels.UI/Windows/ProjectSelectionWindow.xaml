<Window
    x:Class="CopyModels.UI.Windows.ProjectSelectionWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="clr-namespace:CopyModels.UI.ViewModels"
    Title="Выбор проектов"
    Width="860"
    Height="520"
    d:DataContext="{d:DesignInstance Type=vm:ProjectSelectionViewModel}"
    WindowStartupLocation="CenterScreen"
    mc:Ignorable="d">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <ListBox
            x:Name="TaskList"
            Grid.Row="0"
            DisplayMemberPath="DisplayName"
            FontFamily="Consolas"
            ItemsSource="{Binding AllSettings}"
            SelectedItem="{Binding SelectedProject}"
            SelectionMode="Single" />
        <StackPanel
            Grid.Row="1"
            HorizontalAlignment="Right"
            Orientation="Horizontal">
            <Button
                Width="80"
                Margin="0,8,8,8"
                Command="{Binding OkCommand}"
                Content="Ok" />
            <Button
                Width="80"
                Margin="0,8,8,8"
                Command="{Binding CancelCommand}"
                Content="Cancel" />
        </StackPanel>
        <StatusBar Grid.Row="2">
            <StatusBarItem>
                <TextBlock Text="{Binding StatusMessage}" />
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>
